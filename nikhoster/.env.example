# ── NIK HOSTER v1 ─────────────────────────────────────────────
# bot token (@BotFather se lo)
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# tera telegram user id (panel + admin)
OWNER_ID=8905002151
# extra admins, comma separated
ADMIN_IDS=

# links
SUPPORT_URL=https://t.me/yourusername
UPDATES_URL=

# ── limits ──
NK_FREE_BOTS=1
NK_PRO_BOTS=5
NK_ELITE_BOTS=15
NK_MAX_UPLOAD_MB=20

# ── engine ──
NK_MAX_RESTARTS=5
NK_RESTART_BACKOFF=4
NK_WATCHDOG_INTERVAL=3
NK_AUTOFIX=true
NK_AUTOSTART=true
NK_LIVE_REFRESH=4

# optional: data folder badalna ho to
# NK_DATA_DIR=/opt/nikhoster/data
